# Salin menjadi mobile/.env bila perlu. File .env TIDAK di-commit.

# Alamat backend. Kosongkan agar otomatis memakai IP laptop yang menjalankan Expo
# (backend harus HOST=0.0.0.0, hanya bisa di mode after). Contoh lain:
#   HP Android lewat kabel USB + `adb reverse tcp:4000 tcp:4000`  → http://localhost:4000
#   Emulator Android                                               → http://10.0.2.2:4000
#   HP lewat Wi-Fi                                                 → http://192.168.x.x:4000
EXPO_PUBLIC_API_URL=

# Samakan dengan SECURITY_MODE backend (before|after). Mode before menampilkan pita peringatan.
EXPO_PUBLIC_SECURITY_MODE=after
