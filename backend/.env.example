# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.

# Mode keamanan aplikasi:
#   before = versi rentan untuk pengujian OWASP (HANYA lokal: otomatis listen di 127.0.0.1,
#            dan server menolak jalan bila NODE_ENV=production)
#   after  = versi yang sudah diamankan (default bila dikosongkan)
# Samakan dengan VITE_SECURITY_MODE di web/.env.
SECURITY_MODE=after

# Port server Express
PORT=4000

# Connection string dari Neon (Dashboard > Connect > Connection string).
# Ganti sslmode=require menjadi sslmode=verify-full (SSL + verifikasi sertifikat server).
# Saran: pakai branch database Neon terpisah untuk before dan after.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Kunci rahasia untuk menandatangani JWT (mode after: minimal 32 karakter). Contoh membuat:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- Khusus mode after ---
# Origin web yang boleh memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:5173
# Host yang didengar server. Lokal: 127.0.0.1. Saat deploy (mode after): 0.0.0.0.
HOST=127.0.0.1
# Password untuk akun seed. Kosongkan agar dibuat acak dan ditampilkan sekali saat db:seed.
SEED_PASSWORD=
